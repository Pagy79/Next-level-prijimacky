# Zkopíruj jako .env.local a doplň hodnoty z Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Volitelné — pro plný audit / server skripty (NIKDY necommituj, nepoužívej ve frontendu)
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Denní e-mailové připomínky (Resend + Vercel Cron)
# Odesílatel: info@fachmanka.cz (doména musí být ověřená v Resend)
RESEND_API_KEY=re_...
CRON_SECRET=nahodny-dlouhy-retezec
APP_URL=https://www.kompasnaskolu.cz
# Volitelné aliasy (stejný význam jako APP_URL):
# VITE_APP_URL=https://www.kompasnaskolu.cz
# NEXT_PUBLIC_APP_URL=https://www.kompasnaskolu.cz

# Stripe PREMIUM (69 Kč jednorázově) — klíče jen na Vercel / .env.local, ne do gitu
